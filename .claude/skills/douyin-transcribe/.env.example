# faster-whisper 模型选择（越大越准，越慢）
# 可选: tiny, small, medium, large-v3
# 脚本会按 small → tiny 顺序尝试，选第一个可用的（small 优先，已缓存）
WHISPER_MODEL_PREFERENCE=small

# 输出目录（默认: ./douyin-transcripts）
# OUTPUT_DIR=./douyin-transcripts

# 临时文件目录（默认: ./temp）
# TEMP_DIR=./temp

# ffmpeg 路径（通常自动检测）
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
